{
    "name": "spekta-cli",
    "version": "1.0.0",
    "type": "module",
    "bin": {
        "spekta": "./dist/index.js"
    },
    "scripts": {
        "build": "vite build",
        "deploy": "npm run build && chmod +x dist/index.js && npm link .",
        "test": "vitest",
        "test:json": "vitest --reporter=json --outputFile=./spekta/test-results.json",
        "update": "npx npm-check-updates --interactive --format group",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@inquirer/prompts": "^8.7.2",
        "@modelcontextprotocol/sdk": "^1.30.1",
        "@prettier/plugin-php": "^0.25.0",
        "@xberg-io/tree-sitter-language-pack": "^1.20.0",
        "boxen": "^8.0.1",
        "chalk": "^5.6.2",
        "dotenv": "^17.4.2",
        "execa": "^9.6.1",
        "fs-extra": "^11.4.1",
        "gpt-tokenizer": "^3.4.0",
        "gray-matter": "^4.0.3",
        "ignore": "^7.0.10",
        "inquirer-autocomplete-standalone": "^0.8.1",
        "is-binary-path": "^3.0.0",
        "nunjucks": "^3.2.4",
        "openai": "^6.39.1",
        "ora": "^9.4.1",
        "prettier": "^3.9.9",
        "shlex": "^3.0.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^25.9.1",
        "@types/nunjucks": "^3.2.6",
        "eslint": "^10.11.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^4.1.10"
    }
}