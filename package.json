{
    "name": "spekta-cli",
    "version": "1.0.0",
    "type": "module",
    "bin": {
        "spekta": "./dist/index.js"
    },
    "scripts": {
        "build": "vite build",
        "deploy": "npm run build && chmod +x dist/index.js && npm link .",
        "test": "vitest",
        "test:json": "vitest --reporter=json --outputFile=./spekta/test-results.json",
        "update": "npx npm-check-updates --interactive --format group"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@inquirer/prompts": "^8.5.2",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@prettier/plugin-php": "^0.25.0",
        "boxen": "^8.0.1",
        "chalk": "^5.6.2",
        "dotenv": "^17.4.2",
        "execa": "^9.6.1",
        "fs-extra": "^11.4.0",
        "gpt-tokenizer": "^3.4.0",
        "ignore": "^7.0.6",
        "inquirer-autocomplete-standalone": "^0.8.1",
        "is-binary-path": "^3.0.0",
        "openai": "^6.39.1",
        "ora": "^9.4.1",
        "prettier": "^3.9.6",
        "shlex": "^3.0.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
