{
  "name": "spekta-cli",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spekta": "./dist/index.js",
    "spekta-codex-hook": "./dist/codex-hook.js"
  },
  "scripts": {
    "build": "vite build",
    "deploy": "npm run build && chmod +x dist/index.js dist/codex-hook.js && npm link .",
    "test": "vitest",
    "test:codex-hook": "vitest run src/codex-hook*.test.ts",
    "test:find-backend": "SPEKTA_FIND_BACKEND_TESTS=1 vitest run src/commands/proxy/proxy-find.backend.test.ts",
    "test:json": "vitest --reporter=json --outputFile=./spekta/test-results.json",
    "update": "npx npm-check-updates --interactive --format group",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prettier/plugin-php": "^0.25.0",
    "@xberg-io/tree-sitter-language-pack": "^1.22.1",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.8",
    "execa": "^10.2.0",
    "fs-extra": "^11.4.1",
    "gpt-tokenizer": "^3.4.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.12",
    "inquirer-autocomplete-standalone": "^0.8.1",
    "is-binary-path": "^3.0.0",
    "nunjucks": "^3.2.4",
    "openai": "^6.39.1",
    "ora": "^9.4.1",
    "prettier": "^3.9.10",
    "shlex": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/nunjucks": "^3.2.6",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
